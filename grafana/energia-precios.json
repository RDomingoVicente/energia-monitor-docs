          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT\n  coalesce(ssaa_origen || ' (' || ssaa_metodo || ')', 'sin valor') AS \"SSAA\",\n  coalesce((SELECT string_agg(k, ', ' ORDER BY k) FROM jsonb_each_text(estado_componentes) e(k, v) WHERE v = 'real'), 'ninguno') AS \"Reales\",\n  coalesce((SELECT string_agg(k, ', ' ORDER BY k) FROM jsonb_each_text(estado_componentes) e(k, v) WHERE v = 'estimado'), 'ninguno') AS \"Estimados\",\n  coalesce((SELECT string_agg(k, ', ' ORDER BY k) FROM jsonb_each_text(estado_componentes) e(k, v) WHERE v IN ('regulado', 'contrato')), 'ninguno') AS \"Regulados y contrato\"\nFROM v_precio_final\nWHERE contrato = '$contrato' AND fuente = '$fuente' AND inicio <= now() AND fin > now()"
        }
      ],
