    {
      "id": 7,
      "type": "table",
      "title": "Horas más baratas (próximas 36 h)",
      "description": "Media de los cuatro cuartos de hora de cada hora, ordenadas por precio final.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "${ds}"
      },
      "gridPos": {
        "x": 12,
        "y": 13,
        "w": 12,
        "h": 14
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "${ds}"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "WITH horas AS (\n  -- Hora UTC: en España el desfase es de horas enteras, así que cada hora UTC es\n  -- una hora local, y el día del cambio de hora las dos 02:00 no se mezclan.\n  SELECT\n    date_trunc('hour', inicio AT TIME ZONE 'UTC') AT TIME ZONE 'UTC' AS hora,\n    min(periodo) AS periodo,\n    avg(omie_eur_mwh) AS omie,\n    avg(precio_final_eur_kwh) AS precio_final\n  FROM v_precio_final\n  WHERE contrato = '$contrato' AND fuente = '$fuente' AND inicio >= now() - interval '1 hour' AND inicio < now() + interval '37 hours'\n  GROUP BY 1\n)\n-- Horas completas (los cuatro cuartos) que aún no han terminado.\nSELECT hora AS \"Hora\", periodo AS \"Periodo\", omie AS \"OMIE (€/MWh)\", precio_final AS \"Precio final (€/kWh)\"\nFROM horas\nWHERE hora + interval '1 hour' > now() AND hora < now() + interval '36 hours'\nORDER BY precio_final NULLS LAST, hora\nLIMIT 12"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            }
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Hora"
            },
            "properties": [
              {
                "id": "unit",
                "value": "time:ddd DD/MM HH:mm"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "OMIE (€/MWh)"
            },
            "properties": [
              {
                "id": "decimals",
                "value": 2
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Precio final (€/kWh)"
            },
            "properties": [
              {
                "id": "decimals",
                "value": 4
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": {
          "show": false
        }
      }
    },
