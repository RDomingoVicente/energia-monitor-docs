    {
      "id": 11,
      "type": "timeseries",
      "title": "PVPC 2.0TD frente a mi precio (€/kWh, ambos con IEE e IVA)",
      "description": "Por hora. Mi precio: precio final (media de los cuatro tramos de la hora). PVPC: indicador 1001 de ESIOS (término de energía con peajes y cargos) × (1 + IEE) × (1 + IVA) del contrato. Los dos lados con impuestos.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "${ds}"
      },
      "gridPos": {
        "x": 0,
        "y": 38,
        "w": 16,
        "h": 9
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "${ds}"
          },
          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT inicio AS time,\n  precio_final_eur_kwh AS \"Mi precio\",\n  pvpc_final_eur_kwh AS \"PVPC\"\nFROM v_comparacion_pvpc\nWHERE $__timeFilter(inicio) AND contrato = '$contrato' AND fuente = '$fuente'\nORDER BY 1"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "suffix: €/kWh",
          "decimals": 4,
