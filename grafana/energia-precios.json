            "uid": "${ds}"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT\n  to_char((inicio AT TIME ZONE 'Europe/Madrid')::date, 'YYYY-MM-DD') AS \"Día\",\n  string_agg(DISTINCT ssaa_metodo, ', ') AS \"Método\",\n  string_agg(DISTINCT ssaa_origen, ', ') AS \"Origen\",\n  avg(ssaa) AS \"SSAA medio (€/MWh)\",\n  avg(precio_final_eur_kwh) AS \"Precio final medio (€/kWh)\"\nFROM v_precio_final\nWHERE contrato = '$contrato' AND fuente = '$fuente'\n  AND inicio >= date_trunc('day', now() AT TIME ZONE 'Europe/Madrid') AT TIME ZONE 'Europe/Madrid' - interval '10 days'\n  AND inicio < date_trunc('day', now() AT TIME ZONE 'Europe/Madrid') AT TIME ZONE 'Europe/Madrid' + interval '2 days'\nGROUP BY 1\nORDER BY 1 DESC"
        }
      ],
