    {
      "id": 1,
      "type": "stat",
      "title": "Precio final ahora",
      "description": "Coste marginal del kWh en el tramo actual: mercado + componentes + peaje y cargo del periodo, con IEE e IVA.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "${ds}"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
