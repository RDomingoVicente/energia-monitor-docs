          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT\n  date_trunc('day', inicio AT TIME ZONE 'Europe/Madrid') AT TIME ZONE 'Europe/Madrid' AS time,\n  sum(coste_eur) FILTER (WHERE origen_energia = 'muestreo')  AS \"Medido (€)\",\n  sum(coste_eur) FILTER (WHERE origen_energia <> 'muestreo') AS \"Estimado (€)\",\n  sum(energia_kwh) AS \"Energía (kWh)\"\nFROM v_coste_tramo\nWHERE contrato = '$contrato' AND fuente = '$fuente' AND consumidor = 'coche'\n  AND inicio >= (date_trunc('day', now() AT TIME ZONE 'Europe/Madrid') - interval '29 days') AT TIME ZONE 'Europe/Madrid'\nGROUP BY 1\nORDER BY 1"
        }
