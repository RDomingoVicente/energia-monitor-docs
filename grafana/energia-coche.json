  "panels": [
    {
      "id": 17,
      "type": "stat",
      "title": "Gasto del coche",
      "description": "Euros (con IEE e IVA) y kWh del coche hoy, en la semana y en el mes en curso (Europe/Madrid). kWh corregidos con el factor del contador del cargador (parámetro estimado). \"Mes estimado\": energía de sesiones anteriores al muestreo, repartida a potencia constante.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "${ds}"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 5
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "${ds}"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "WITH lim AS (\n  SELECT\n    date_trunc('day', now() AT TIME ZONE 'Europe/Madrid') AT TIME ZONE 'Europe/Madrid' AS hoy,\n    date_trunc('week', now() AT TIME ZONE 'Europe/Madrid') AT TIME ZONE 'Europe/Madrid' AS semana,\n    date_trunc('month', now() AT TIME ZONE 'Europe/Madrid') AT TIME ZONE 'Europe/Madrid' AS mes\n)\nSELECT\n  coalesce(sum(c.coste_eur)   FILTER (WHERE c.inicio >= l.hoy), 0)    AS \"Hoy (€)\",\n  coalesce(sum(c.energia_kwh) FILTER (WHERE c.inicio >= l.hoy), 0)    AS \"Hoy (kWh)\",\n  coalesce(sum(c.coste_eur)   FILTER (WHERE c.inicio >= l.semana), 0) AS \"Semana (€)\",\n  coalesce(sum(c.energia_kwh) FILTER (WHERE c.inicio >= l.semana), 0) AS \"Semana (kWh)\",\n  coalesce(sum(c.coste_eur)   FILTER (WHERE c.inicio >= l.mes), 0)    AS \"Mes (€)\",\n  coalesce(sum(c.energia_kwh) FILTER (WHERE c.inicio >= l.mes), 0)    AS \"Mes (kWh)\",\n  coalesce(sum(c.energia_kwh) FILTER (WHERE c.inicio >= l.mes AND c.origen_energia <> 'muestreo'), 0)\n    AS \"Mes estimado (kWh)\"\nFROM lim l\nLEFT JOIN v_coste_tramo c\n  ON c.contrato = '$contrato' AND c.fuente = '$fuente' AND c.consumidor = 'coche'\n AND c.inicio >= least(l.semana, l.mes) AND c.inicio < now()"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "noValue": "—",
          "color": {
            "mode": "fixed",
            "fixedColor": "text"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byRegexp",
              "options": "/€\\)$/"
            },
            "properties": [
              {
                "id": "unit",
                "value": "suffix: €"
              },
              {
                "id": "decimals",
                "value": 2
              }
            ]
          },
          {
            "matcher": {
              "id": "byRegexp",
              "options": "/kWh\\)$/"
            },
            "properties": [
              {
                "id": "unit",
                "value": "suffix: kWh"
              },
              {
                "id": "decimals",
                "value": 1
              }
            ]
          },
          {
            "matcher": {
              "id": "byRegexp",
              "options": "/€\\/kWh\\)$/"
            },
            "properties": [
              {
                "id": "unit",
                "value": "suffix: €/kWh"
              },
              {
                "id": "decimals",
                "value": 4
              }
            ]
          }
        ]
      },
      "options": {
