    {
      "id": 18,
      "type": "stat",
      "title": "Gasto en el rango",
      "description": "Euros, kWh y €/kWh medio del coche en el rango del selector. \"Estimado\": kWh de sesiones anteriores al muestreo.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "${ds}"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 5
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "${ds}"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT\n  coalesce(sum(coste_eur), 0)   AS \"Gasto (€)\",\n  coalesce(sum(energia_kwh), 0) AS \"Energía (kWh)\",\n  sum(coste_eur) / nullif(sum(energia_kwh), 0) AS \"Medio (€/kWh)\",\n  coalesce(sum(energia_kwh) FILTER (WHERE origen_energia <> 'muestreo'), 0) AS \"Estimado (kWh)\"\nFROM v_coste_tramo\nWHERE $__timeFilter(inicio) AND contrato = '$contrato' AND fuente = '$fuente' AND consumidor = 'coche'"
        }
      ],
      "fieldConfig": {
        "defaults": {
