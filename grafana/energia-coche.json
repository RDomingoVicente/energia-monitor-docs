          "rawSql": "SELECT\n  periodo AS \"Periodo\",\n  sum(energia_kwh) AS \"Energía (kWh)\",\n  sum(coste_eur) AS \"Coste (€)\",\n  sum(coste_eur) / nullif(sum(energia_kwh), 0) AS \"Medio (€/kWh)\"\nFROM v_coste_tramo\nWHERE $__timeFilter(inicio) AND contrato = '$contrato' AND fuente = '$fuente' AND consumidor = 'coche'\nGROUP BY periodo\nORDER BY periodo"
        }
