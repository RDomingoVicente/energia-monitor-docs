    {
      "id": 19,
      "type": "stat",
      "title": "Precio medio pagado",
      "description": "€/kWh pagado por el coche (ponderado por su energía) frente a la media simple del precio final en el mismo rango, hasta ahora. Ambos con IEE e IVA.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "${ds}"
