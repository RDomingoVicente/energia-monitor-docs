    {
      "id": 21,
      "type": "stat",
      "title": "Estado del cargador",
      "description": "Última muestra del cargador. Estado del conector según la interfaz del cargador (1, 4 y 6 verificados el 14/11/2026; el resto, del código). La potencia de la casa está sin verificar y se muestra vacía mientras carga el coche: durante la carga homePower = 0 (homePower = max(0, total − evse)), así que la casa es desconocida.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "${ds}"
      },
      "gridPos": {
        "x": 16,
        "y": 5,
        "w": 8,
        "h": 6
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "${ds}"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT\n  CASE\n    WHEN estado IN (1, 2) THEN 'Libre'\n    WHEN estado IN (3, 4) THEN 'Conectado'\n    WHEN estado IN (5, 6) THEN 'Cargando'\n    WHEN estado = 7 THEN 'Pausado'\n    WHEN estado = 8 THEN 'Carga finalizada'\n    WHEN estado = 32 THEN 'Inoperativo'\n    WHEN estado IS NULL THEN 'Sin lectura'\n    ELSE 'Otro (' || estado || ')'\n  END AS \"Conector\",\n  evse_w AS \"Coche (W)\",\n  -- Durante la carga homePower = 0: la casa es desconocida, no 0.\n  CASE WHEN evse_w > 0 THEN NULL ELSE home_w END AS \"Casa, sin verificar (W)\",\n  extract(epoch FROM now() - instante)::integer AS \"Última muestra (s)\"\nFROM cargador_muestra\nORDER BY instante DESC\nLIMIT 1"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "noValue": "—",
          "color": {
