      "id": 9,
      "type": "stat",
      "title": "Mes en curso (media hasta ahora)",
      "description": "Media simple desde el día 1 del mes hasta ahora; no está ponderada por consumo.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "${ds}"
      },
      "gridPos": {
        "x": 16,
        "y": 22,
        "w": 8,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "${ds}"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT\n  avg(precio_final_eur_kwh) AS \"Precio final\",\n  avg(omie_eur_mwh) AS \"OMIE\"\nFROM v_precio_final\nWHERE contrato = '$contrato' AND fuente = '$fuente'\n  AND inicio >= date_trunc('month', now() AT TIME ZONE 'Europe/Madrid') AT TIME ZONE 'Europe/Madrid'\n  AND inicio < now()"
        }
      ],
      "fieldConfig": {
        "defaults": {
