    {
      "id": 3,
      "type": "stat",
      "title": "Periodo 2.0TD ahora",
      "description": "P1 punta, P2 llano, P3 valle (Circular CNMC 3/2020).",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "${ds}"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 4,
        "h": 4
