          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT omie_eur_mwh AS \"OMIE\"\nFROM v_precio_final\nWHERE contrato = '$contrato' AND fuente = '$fuente' AND inicio <= now() AND fin > now()"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "suffix: €/MWh",
