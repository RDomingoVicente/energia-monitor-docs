          "rawQuery": true,
          "rawSql": "SELECT inicio AS time, omie_eur_mwh AS \"OMIE\"\nFROM v_precio_final\nWHERE $__timeFilter(inicio) AND contrato = '$contrato' AND fuente = '$fuente'\nORDER BY 1"
        }
