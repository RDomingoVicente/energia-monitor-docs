    {
      "id": 7,
      "type": "table",
      "title": "Horas más baratas (próximas 36 h)",
      "description": "Media de los cuatro cuartos de hora de cada hora, ordenadas por precio final.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "${ds}"
      },
      "gridPos": {
        "x": 12,
        "y": 13,
        "w": 12,
        "h": 9
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "${ds}"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT\n  min(inicio) AS \"Hora\",\n  min(periodo) AS \"Periodo\",\n  avg(omie_eur_mwh) AS \"OMIE (€/MWh)\",\n  avg(precio_final_eur_kwh) AS \"Precio final (€/kWh)\"\nFROM v_precio_final\nWHERE contrato = '$contrato' AND fuente = '$fuente' AND fin > now() AND inicio < now() + interval '36 hours'\nGROUP BY date_trunc('hour', inicio)\nORDER BY avg(precio_final_eur_kwh) NULLS LAST, 1\nLIMIT 12"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            }
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Hora"
            },
            "properties": [
              {
                "id": "unit",
                "value": "time:ddd DD/MM HH:mm"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "OMIE (€/MWh)"
            },
            "properties": [
              {
                "id": "decimals",
                "value": 2
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Precio final (€/kWh)"
            },
            "properties": [
              {
                "id": "decimals",
                "value": 4
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": {
          "show": false
        }
      }
    },
