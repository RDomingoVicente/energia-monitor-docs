          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT\n  date_trunc('day', inicio AT TIME ZONE 'Europe/Madrid') AT TIME ZONE 'Europe/Madrid' AS time,\n  avg(precio_final_eur_kwh) AS \"Media diaria\"\nFROM v_precio_final\nWHERE $__timeFilter(inicio) AND contrato = '$contrato' AND fuente = '$fuente'\nGROUP BY 1\nORDER BY 1"
