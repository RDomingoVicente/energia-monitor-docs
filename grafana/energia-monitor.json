    {
      "id": 10,
      "type": "stat",
      "title": "Componentes del tramo actual",
      "description": "Estimados: parámetros sin serie real (SSAA, ROS...) tomados de normas o estimaciones; ver docs/parametros.md. Sin valor: si aparece alguno, el precio final no se puede calcular.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "${ds}"
      },
      "gridPos": {
        "x": 0,
        "y": 30,
        "w": 24,
        "h": 3
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "${ds}"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT\n  coalesce(nullif(array_to_string(componentes_estimados, ', '), ''), 'ninguno') AS \"Estimados\",\n  coalesce(nullif(array_to_string(componentes_pendientes, ', '), ''), 'ninguno') AS \"Sin valor\"\nFROM v_precio_final\nWHERE contrato = '$contrato' AND fuente = '$fuente' AND inicio <= now() AND fin > now()"
        }
      ],
