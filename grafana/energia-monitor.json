      "id": 8,
      "type": "timeseries",
      "title": "Precio final: media diaria (€/kWh)",
      "description": "Media simple de los tramos de cada día (hora de Madrid), últimos 30 días.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
