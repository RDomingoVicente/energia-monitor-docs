  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Precio final ahora",
      "description": "Coste marginal del kWh en el tramo actual: mercado + componentes + peaje y cargo del periodo, con IEE e IVA.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "${ds}"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "${ds}"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT precio_final_eur_kwh AS \"Precio final\"\nFROM v_precio_final\nWHERE contrato = '$contrato' AND fuente = '$fuente' AND inicio <= now() AND fin > now()"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "suffix: €/kWh",
          "decimals": 4,
          "noValue": "—",
          "color": {
            "mode": "fixed",
            "fixedColor": "text"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "none",
        "graphMode": "none",
        "textMode": "value",
        "justifyMode": "auto",
        "orientation": "auto",
        "wideLayout": true,
        "showPercentChange": false
      }
    },
