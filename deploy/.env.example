# Copiar a .env en el NAS (no subir a git)

# Registry Harbor: host:puerto, sin https://
HARBOR_REGISTRY=
HARBOR_PROJECT=energia
COLLECTOR_TAG=latest

POSTGRES_DB=energia
POSTGRES_USER=energia
POSTGRES_PASSWORD=

# Exposición de PostgreSQL para Grafana
PG_BIND=127.0.0.1
PG_PORT=5434

# Fuente de precios: omie | esios
PRICE_SOURCE=omie
ESIOS_TOKEN=

# Contraseña del usuario de solo lectura grafana_ro (datasource de Grafana).
# Si se deja vacía, grafana_ro no puede iniciar sesión.
GRAFANA_DB_PASSWORD=

# Colector (opcionales)
# Primer día de la carga inicial; al arrancar se descargan los días que falten.
CARGA_INICIAL_DESDE=2025-10-01
# Horas de Europe/Madrid: la primera tras la publicación de OMIE, el resto reintentos.
HORARIOS=13:30,17:30,20:30
# Segundos mínimos entre peticiones a la fuente.
INTERVALO_DESCARGAS_S=1
