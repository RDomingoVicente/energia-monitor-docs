# Copiar a .env en el NAS (no subir a git)

# Registry Harbor: host:puerto, sin https://
HARBOR_REGISTRY=
HARBOR_PROJECT=energia
COLLECTOR_TAG=latest

POSTGRES_DB=energia
POSTGRES_USER=energia
POSTGRES_PASSWORD=

# Exposición de PostgreSQL para Grafana
PG_BIND=127.0.0.1
PG_PORT=5434

# Fuente del precio de mercado: omie
PRICE_SOURCE=omie

# Token personal de ESIOS (REE). Opcional: sin él no se descargan SSAA ni el
# PVPC y el SSAA sale del parámetro estimado. No subir a git.
ESIOS_TOKEN=

# Contraseña del usuario de solo lectura grafana_ro (datasource de Grafana).
# Si se deja vacía, grafana_ro no puede iniciar sesión.
GRAFANA_DB_PASSWORD=

# Colector (opcionales)
# Primer día de la carga inicial; al arrancar se descargan los días que falten.
CARGA_INICIAL_DESDE=2025-10-01
# Horas de Europe/Madrid: la primera tras la publicación de OMIE, el resto reintentos.
HORARIOS=13:30,17:30,20:30
# Segundos mínimos entre peticiones a la fuente (OMIE y ESIOS).
INTERVALO_DESCARGAS_S=1
# ESIOS: primer día de la carga inicial y horas (Europe/Madrid) de descarga:
# 08:30 tras la actualización diaria de REE; 21:00 y 22:00 tras el PVPC y la
# previsión de SSAA del día siguiente. Los domingos, la primera recarga 90 días.
ESIOS_CARGA_DESDE=2026-01-01
ESIOS_HORARIOS=08:30,21:00,22:00

# Cargador Orbis Viaris en la LAN (http://host, sin ruta). Vacía: el servicio
# muestreo queda en espera y el colector de precios no cambia.
VIARIS_URL=http://192.168.1.34
